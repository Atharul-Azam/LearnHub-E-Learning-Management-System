# Copy to .env and edit. Never commit the real .env file.
# Used by config.settings.dev (manage.py) and config.settings.prod (wsgi.py).

# --- required in production ---
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=learnhub.example.edu
CSRF_TRUSTED_ORIGINS=https://learnhub.example.edu

# --- development ---
DEBUG=True

# --- production HTTPS (SRS 22.3). Terminate HTTPS at the web server / proxy. ---
USE_HTTPS=True
BEHIND_PROXY=False
SECURE_HSTS_SECONDS=31536000

# --- storage ---
# DB_PATH=/var/lib/learnhub/db.sqlite3
# MEDIA_ROOT=/var/lib/learnhub/media

# --- behaviour ---
TIME_ZONE=Asia/Dhaka
SESSION_INACTIVITY_TIMEOUT_SECONDS=1800
PAGE_SIZE=12
MAX_THUMBNAIL_MB=2
MAX_MATERIAL_MB=50
MAX_ATTACHMENT_MB=20
MAX_SUBMISSION_MB=20
LOG_LEVEL=INFO
