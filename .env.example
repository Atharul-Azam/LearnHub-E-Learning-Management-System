# Copy to .env and edit. Never commit the real .env file.
# Used by config.settings.dev (manage.py) and config.settings.prod (wsgi.py).

# --- required in production ---
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=learnhub.example.edu
CSRF_TRUSTED_ORIGINS=https://learnhub.example.edu

# --- development ---
DEBUG=True

# --- production HTTPS (SRS 22.3). Terminate HTTPS at the web server / proxy. ---
USE_HTTPS=True
BEHIND_PROXY=False
SECURE_HSTS_SECONDS=31536000

# --- e-mail (verification links) ---
# Without EMAIL_HOST the e-mails are PRINTED IN THE TERMINAL (console backend) - fine for development.
# For real delivery set an SMTP server (use an app password, never your normal password):
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-smtp-username
# EMAIL_HOST_PASSWORD=your-smtp-password
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=LearnHub <no-reply@your-domain>
# Public address used inside e-mails when no request is available.
SITE_URL=http://127.0.0.1:8000
EMAIL_VERIFICATION_TIMEOUT_SECONDS=86400
MAX_AVATAR_MB=2

# --- storage ---
# DB_PATH=/var/lib/learnhub/db.sqlite3
# MEDIA_ROOT=/var/lib/learnhub/media

# --- behaviour ---
TIME_ZONE=Asia/Dhaka
SESSION_INACTIVITY_TIMEOUT_SECONDS=1800
PAGE_SIZE=12
MAX_THUMBNAIL_MB=2
MAX_MATERIAL_MB=50
MAX_ATTACHMENT_MB=20
MAX_SUBMISSION_MB=20
LOG_LEVEL=INFO

# PythonAnywhere example: see docs/DEPLOY_PYTHONANYWHERE.md (BEHIND_PROXY=True, DB_PATH/MEDIA_ROOT outside the code folder)
